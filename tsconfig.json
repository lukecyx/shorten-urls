{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESnext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "paths": {
      "~/*": ["./*"],
      "snowflake": ["infra/lambda-layers/snowflake/nodejs/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "setup.ts"]
}

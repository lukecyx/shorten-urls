# Database connection string
# For local development with connection pooling:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb?connection_limit=5&pool_timeout=10"
#
# For Lambda with RDS Proxy:
# DATABASE_URL="postgresql://user:password@rds-proxy-endpoint:5432/mydb?connection_limit=5&pool_timeout=10"
DATABASE_URL="postgresql://user:password@localhost:5432/shorten_urls?connection_limit=5&pool_timeout=10"

# Existing environment variables
FEISTEL_SECRET=your-secret-key-here
FEISTEL_ROUNDS=4
DOMAIN_BITS=64
CODE_BASE=58
CODE_LENGTH=6
